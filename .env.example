PORT=5000
NODE_ENV=production

# MySQL Database Configuration (Local or Cloud like Aiven / Railway)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=obsidian_trust_bank_db
# Set DB_SSL=true when connecting to cloud MySQL (Aiven, PlanetScale, etc.)
DB_SSL=false
# Optional full connection URI (e.g. from Aiven):
# DATABASE_URL=mysql://avnadmin:password@host:port/defaultdb?ssl-mode=REQUIRED

# JWT Security Secrets
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_PREAUTH_SECRET=your_jwt_preauth_token_key_change_me
JWT_EXPIRES_IN=24h
JWT_PREAUTH_EXPIRES_IN=10m

# CORS Origin for Angular App
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Resend API Key Configuration (resend.com)
# Leave blank to run in simulation/fallback mode
RESEND_API_KEY=
RESEND_FROM_EMAIL=Obsidian Trust Bancorp <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=admin@obsidiantrustbancorp.com
